# Guess the Number (random target: 1..100)
randomnum secret 1 100
say "I picked a random number between 1 and 100."

loop
asknum guess "Your guess: "

ifnumeq guess secret
say "You found it!"
exit 0
endif

ifnumgt guess secret
say "The number is smaller."
endif

ifnumlt guess secret
say "The number is more."
endif
endloop
